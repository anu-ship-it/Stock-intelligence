{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "outDir": "dist",

    "baseUrl": "."
  },

  "include": ["**/*.ts", "**/*.tsx"],

  "exclude": [
    "node_modules",
    "dist"
  ]
}
